#!/bin/sh
# Root-owned config must stay writable by the kiosk group. The service saves every page into this directory.
set -eu
if [ "$(id -u)" -ne 0 ]; then
  echo "pikiosk-fix-perms must run as root" >&2
  exit 1
fi
user_name=${1:-kiosk}
if ! id "$user_name" >/dev/null 2>&1; then
  echo "user $user_name does not exist" >&2
  exit 1
fi
install -d -o root -g "$user_name" -m 2770 /etc/pi-kiosk
chown root:"$user_name" /etc/pi-kiosk
chmod 2770 /etc/pi-kiosk
for path in /etc/pi-kiosk/*; do
  if [ -f "$path" ]; then
    chown root:"$user_name" "$path"
    chmod 0660 "$path"
  fi
done
