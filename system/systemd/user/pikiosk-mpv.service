[Unit]
Description=Pi Video Kiosk mpv player
# Only run inside the Wayland session: labwc starts pikiosk-session.target
# after it has imported WAYLAND_DISPLAY into the user manager.
PartOf=pikiosk-session.target
After=pikiosk-session.target

[Service]
Type=simple
RuntimeDirectory=pi-kiosk
RuntimeDirectoryPreserve=yes
ExecStartPre=/bin/mkdir -p %h/.cache/pi-kiosk
ExecStart=/usr/bin/mpv --idle=yes --force-window=no --config-dir=%h/.config/mpv --input-ipc-server=%t/pi-kiosk/mpv.sock --log-file=%h/.cache/pi-kiosk/mpv.log
Restart=always
RestartSec=2
SyslogIdentifier=pikiosk-mpv

[Install]
WantedBy=pikiosk-session.target
