<!-- pikiosk-start -->
<windowRules>
  <windowRule identifier="mpv" serverDecoration="no">
    <action name="ToggleFullscreen"/>
    <action name="ToggleAlwaysOnTop"/>
    <action name="Focus"/>
  </windowRule>
  <windowRule identifier="chromium*" serverDecoration="no">
    <action name="ToggleFullscreen"/>
  </windowRule>
</windowRules>
<touch mapToOutput="DSI-1"/>
<keyboard>
  <keybind key="A-F4"/>
  <keybind key="A-F11"/>
  <keybind key="W-Return"/>
  <keybind key="W-e"/>
  <keybind key="C-A-t"/>
</keyboard>
<mouse>
  <context name="Root">
    <mousebind button="Right" action="Press"/>
  </context>
</mouse>
<!-- pikiosk-end -->
